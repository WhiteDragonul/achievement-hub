# Copiază în .env și completează. .env nu se comite (e în .gitignore).

# Supabase → Connect → Session pooler (port 5432). NU adăuga ?sslmode=... în URL:
# TLS e configurat în api/src/db/db.ts, iar parametrul din URL l-ar suprascrie.
DATABASE_URL=postgresql://postgres.eswevjeszzgpaopccjta:PAROLA_DB@aws-0-REGIUNE.pooler.supabase.com:5432/postgres
# false doar pentru un Postgres local fără TLS
DATABASE_SSL=true

PORT=3000

# Cheia pentru criptarea tokenurilor platformelor (pgcrypto). Generează una cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Dacă o schimbi după ce există date, tokenurile criptate deja nu mai pot fi decriptate.
TOKEN_ENCRYPTION_KEY=

# Cheia de semnare a tokenurilor de acces (JWT). Generează una la fel ca mai sus.
JWT_SECRET=

# Steam: cheie Web API (https://steamcommunity.com/dev/apikey) + adresele folosite la login-ul Steam OpenID
STEAM_API_KEY=
PUBLIC_API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Fixtures (mii de useri generați, pentru evaluare și load test): true = generate la pornire dacă tabelul users e gol.
# Implicit false: baza conține doar conturile reale. La cerere: `npm run db:seed` în api/.
SEED_ON_START=false
# PSN / Xbox / Epic folosesc date generate (MockProvider); true permite legarea lor (demo).
ALLOW_MOCK_PLATFORMS=false
# Parola comună a userilor de test (admin@ / moderator@ / demo@ / player1..5000@achievementhub.test)
FIXTURE_PASSWORD=Parola123!
