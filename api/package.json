{
  "name": "achievement-hub-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env --import tsx --watch src/main.ts",
    "dev:worker": "node --env-file=../.env --import tsx --watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=../.env --import tsx src/cli/migrate.ts",
    "db:seed": "node --env-file=../.env --import tsx src/cli/seed.ts",
    "db:explain": "node --env-file=../.env --import tsx src/cli/explain.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "user:role": "node --env-file=../.env --import tsx src/cli/set-role.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "argon2": false,
    "esbuild": false
  }
}
