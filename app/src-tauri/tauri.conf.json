{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Achievement Hub",
  "version": "0.1.0",
  "identifier": "com.achievementhub.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../web",
    "beforeBuildCommand": "npm run build:app --prefix ../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Achievement Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#1a0b2e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Toate achievement-urile tale într-un singur profil",
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "achievementhub"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "achievementhub"
          ],
          "appLink": false
        }
      ]
    }
  }
}